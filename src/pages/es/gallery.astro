---
import Layout from "@layouts/Layout.astro";

const images = [
  "https://raw.githubusercontent.com/tomo-hq/dimas/refs/heads/main/src/assets/images/gallery/place1.jpg",
  "https://raw.githubusercontent.com/tomo-hq/dimas/refs/heads/main/src/assets/images/gallery/place2.jpg",
  "https://raw.githubusercontent.com/tomo-hq/dimas/refs/heads/main/src/assets/images/gallery/place3.jpg",
  "https://raw.githubusercontent.com/tomo-hq/dimas/refs/heads/main/src/assets/images/gallery/place4.jpeg",
  "https://raw.githubusercontent.com/tomo-hq/dimas/refs/heads/main/src/assets/images/gallery/place5.jpeg",
  "https://raw.githubusercontent.com/tomo-hq/dimas/refs/heads/main/src/assets/images/gallery/place6.jpg",
  "https://raw.githubusercontent.com/tomo-hq/dimas/refs/heads/main/src/assets/images/gallery/palce7.jpg",
  "https://raw.githubusercontent.com/tomo-hq/dimas/refs/heads/main/src/assets/images/gallery/place8.jpg",
];
---

<Layout
  pageTitle="Dimas Restaurante"
  title="Dimas Restaurante"
  description="Te invitamos a disfrutar de lo mejor de la gastronomía peruana, en una nueva propuesta culinaria que fusiona la cocina tradicional y moderna."
>
  <div class="flex w-full flex-col justify-between">
    <div
      class="masonry-grid mt-14 grid grid-cols-2 gap-1 px-10 pb-16 lg:grid-cols-3 lg:pb-32"
    >
      {
        images.map((item, index) => (
          <div class="masonry-grid-item" data-index={index}>
            <a href={item} class="glightbox">
              <img
                src={item}
                alt={`Place ${index + 1}`}
                class="h-full w-full object-cover object-center"
              />
            </a>
          </div>
        ))
      }
    </div>
  </div>
</Layout>

<script>
  import GLightbox from "glightbox";
  import "../../../node_modules/glightbox/dist/css/glightbox.min.css";

  document.addEventListener("astro:page-load", () => {
    const lightbox = GLightbox({
      touchNavigation: true,
      autoplayVideos: true,
      loop: true,
      draggable: true,
    });
  });
</script>
