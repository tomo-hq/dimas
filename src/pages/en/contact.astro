---
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout
  pageTitle="Dimas Restaurant"
  title="Dimas Restaurant"
  description="We invite you to enjoy the best of Peruvian cuisine, in a new culinary proposal that fuses traditional and modern cooking."
>
  <div class="relative min-h-screen">
    <Image
      src="https://raw.githubusercontent.com/tomo-hq/dimas/refs/heads/main/src/assets/images/stamp.png"
      alt="stamp"
      width={200}
      height={150}
      class="pointer-events-none absolute top-36 right-16 z-0 rotate-[-15deg] opacity-30"
    />

    <form id="contactForm" class="contact-form relative z-10">
      <div class="mx-auto flex h-screen max-w-md flex-col justify-center gap-6">
        <div>
          <label
            for="fullName"
            class="mb-2 block text-sm font-medium text-gray-700"
          >
            Full Name *
          </label>
          <input
            type="text"
            name="fullName"
            id="fullName"
            required
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 transition-colors focus:border-orange-500 focus:ring-2 focus:ring-orange-500"
            placeholder="Your full name"
          />
        </div>

        <div>
          <label
            for="email"
            class="mb-2 block text-sm font-medium text-gray-700"
          >
            Email *
          </label>
          <input
            type="email"
            name="email"
            id="email"
            required
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 transition-colors focus:border-orange-500 focus:ring-2 focus:ring-orange-500"
            placeholder="your@email.com"
          />
        </div>

        <div>
          <label
            for="phone"
            class="mb-2 block text-sm font-medium text-gray-700"
          >
            Phone <span class="text-gray-500">(optional)</span>
          </label>
          <input
            type="tel"
            name="phone"
            id="phone"
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 transition-colors focus:border-orange-500 focus:ring-2 focus:ring-orange-500"
            placeholder="+51 999 999 999"
          />
        </div>

        <div>
          <label
            for="message"
            class="mb-2 block text-sm font-medium text-gray-700"
          >
            Message *
          </label>
          <textarea
            name="message"
            id="message"
            rows="5"
            required
            class="resize-vertical w-full rounded-lg border border-gray-300 bg-white px-4 py-3 transition-colors focus:border-orange-500 focus:ring-2 focus:ring-orange-500"
            placeholder="Write your message here..."></textarea>
        </div>

        <input
          type="hidden"
          name="_subject"
          value="New inquiry from the restaurant's website"
        />

        <div>
          <button
            type="submit"
            id="submitButton"
            class="group flex w-full transform items-center justify-center gap-2 rounded-lg bg-red-900 px-8 py-4 font-semibold text-white shadow-lg transition-all duration-300 hover:-translate-y-1 hover:bg-red-900 hover:shadow-xl disabled:cursor-not-allowed disabled:opacity-50"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="h-5 w-5 -rotate-45 transition-transform duration-300 group-hover:rotate-0"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"
              ></path>
            </svg>
            <span id="buttonText">Send Message</span>
          </button>
        </div>

        <div id="formStatus" class="min-h-[20px] text-center text-sm"></div>

        <p class="text-center text-sm text-gray-600">
          We will get back to you as soon as possible.
        </p>
      </div>
    </form>
  </div>
</Layout>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement;
  const statusDiv = document.getElementById("formStatus") as HTMLDivElement;
  const submitButton = document.getElementById(
    "submitButton",
  ) as HTMLButtonElement;
  const buttonText = document.getElementById("buttonText") as HTMLSpanElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    submitButton.disabled = true;
    buttonText.textContent = "Sending...";
    statusDiv.textContent = "";
    statusDiv.className = "text-center text-sm min-h-[20px]";

    const formData = new FormData(form);
    const fullName = formData.get("fullName") as string;
    const email = formData.get("email") as string;
    const phone = formData.get("phone") as string;
    const originalMessage = formData.get("message") as string;

    const formattedMessage = `
DATOS DEL CONTACTO:
==================
Nombre: ${fullName}
Email: ${email}
${phone ? `Teléfono: ${phone}` : "Teléfono: No proporcionado"}

MENSAJE:
========
${originalMessage}

---
Este mensaje fue enviado desde el formulario de contacto del sitio web de Dimas Restaurante.
    `.trim();
    formData.set("message", formattedMessage);

    try {
      const response = await fetch(`https://formspree.io/f/xblyvngp`, {
        method: "POST",
        body: formData,
        headers: {
          Accept: "application/json",
        },
      });

      if (response.ok) {
        statusDiv.textContent = "Message sent successfully";
        statusDiv.className =
          "text-center text-sm min-h-[20px] text-green-600 font-medium";
        form.reset();
      } else {
        const data = await response.json();
        const errorMessage = data.errors
          ? data.errors.map((e: any) => e.message).join(", ")
          : "Error while sending mail. Try again later";

        statusDiv.textContent = errorMessage;
        statusDiv.className =
          "text-center text-sm min-h-[20px] text-red-600 font-medium";
      }
    } catch (error) {
      statusDiv.textContent = "There's no internet conection. Try again later";
      statusDiv.className =
        "text-center text-sm min-h-[20px] text-red-600 font-medium";
    } finally {
      submitButton.disabled = false;
      buttonText.textContent = "Send message";
    }
  });
</script>
