---
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout
  pageTitle="Dimas Restaurante"
  title="Dimas Restaurante"
  description="Te invitamos a disfrutar de lo mejor de la gastronomía peruana, en una nueva propuesta culinaria que fusiona la cocina tradicional y moderna."
>
  <div class="relative min-h-screen">
    <Image
      src="https://raw.githubusercontent.com/tomo-hq/dimas/refs/heads/main/src/assets/images/stamp.png"
      alt="stamp"
      width={200}
      height={150}
      class="pointer-events-none absolute top-36 right-16 z-0 rotate-[-15deg] opacity-30"
    />

    <form
      action="https://formspree.io/f/TU_FORM_ID"
      method="POST"
      class="contact-form relative z-10"
    >
      <div class="mx-auto flex h-screen max-w-md flex-col justify-center gap-6">
        <div>
          <label
            for="email"
            class="mb-2 block text-sm font-medium text-gray-700"
          >
            Email *
          </label>
          <input
            type="email"
            name="email"
            id="email"
            required
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 transition-colors focus:border-orange-500 focus:ring-2 focus:ring-orange-500"
            placeholder="tu@email.com"
          />
        </div>

        <div>
          <label
            for="message"
            class="mb-2 block text-sm font-medium text-gray-700"
          >
            Mensaje *
          </label>
          <textarea
            name="message"
            id="message"
            rows="5"
            required
            class="resize-vertical w-full rounded-lg border border-gray-300 bg-white px-4 py-3 transition-colors focus:border-orange-500 focus:ring-2 focus:ring-orange-500"
            placeholder="Escribe tu mensaje aquí..."></textarea>
        </div>

        <input
          type="hidden"
          name="_subject"
          value="Nueva consulta desde el sitio web del restaurante"
        />

        <div>
          <button
            type="submit"
            class="group flex w-full transform items-center justify-center gap-2 rounded-lg bg-red-900 px-8 py-4 font-semibold text-white shadow-lg transition-all duration-300 hover:-translate-y-1 hover:bg-red-900 hover:shadow-xl"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="h-5 w-5 -rotate-45 transition-transform duration-300 group-hover:rotate-0"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"
              ></path>
            </svg>
            Enviar mensaje
          </button>
        </div>

        <p class="text-center text-sm text-gray-600">
          Te responderemos lo mas pronto posible.
        </p>
      </div>
    </form>
  </div>
</Layout>
