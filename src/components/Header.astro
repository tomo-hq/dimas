---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";

const { currentLocale } = Astro;
const contactURL = getRelativeLocaleUrl(currentLocale ?? "en", "contact");
const locationURL = getRelativeLocaleUrl(currentLocale ?? "en");
const galleryURL = getRelativeLocaleUrl(currentLocale ?? "en", "gallery");
const homeURL = getRelativeLocaleUrl(currentLocale ?? "en");

const fullLocationURL = `${locationURL}#location`;
---

<header class="fixed top-0 left-0 z-50 w-full transition-all duration-300">
  <!-- para mobile -->
  <article class="bg-white shadow-lg md:hidden">
    <nav class="px-4 py-3">
      <ul class="flex items-center justify-between">
        <li>
          <a
            href={fullLocationURL}
            class="text-gray-800 transition-colors hover:text-red-950"
          >
            {currentLocale === "es" ? "Ubicanos" : "Locate Us"}
          </a>
        </li>
        <li>
          <a
            href={"/carta.pdf"}
            class="text-gray-800 transition-colors hover:text-red-950"
          >
            {currentLocale === "es" ? "Carta" : "Menu"}
          </a>
        </li>
        <li>
          <a href={homeURL} class="flex items-center">
            <Image
              src="https://raw.githubusercontent.com/tomo-hq/dimas/refs/heads/static/src/assets/images/dimas/logo.png"
              alt="Logo"
              class="h-12 w-12 rounded-full transition-transform duration-300"
              width={200}
              height={200}
            />
          </a>
        </li>
        <li>
          <a
            href={galleryURL}
            class="text-gray-800 transition-colors hover:text-red-950"
          >
            {currentLocale === "es" ? "Galeria" : "Gallery"}
          </a>
        </li>
        <li>
          <a
            href={contactURL}
            class="text-gray-800 transition-colors hover:text-red-950"
          >
            {currentLocale === "es" ? "Contacto" : "Contact"}
          </a>
        </li>
      </ul>
    </nav>
    <div class="dents before:dents"></div>
  </article>

  <!-- para pc -->
  <article
    class="hidden items-center justify-between px-6 py-4 align-middle md:flex"
  >
    <a
      href={homeURL}
      class="rounded-full bg-white p-3 shadow-md transition-all duration-300 hover:scale-105"
    >
      <Image
        src="https://raw.githubusercontent.com/tomo-hq/dimas/refs/heads/static/src/assets/images/dimas/logo.png"
        alt="Logo"
        class="h-24 w-24 rounded-full transition-all duration-300"
        width={300}
        height={300}
      />
    </a>
    <nav
      class="flex min-h-12 items-center justify-between rounded-2xl bg-white px-6 py-3 shadow-lg transition-all duration-300"
    >
      <ul class="flex justify-between space-x-8">
        <li>
          <a
            href={"/carta.pdf"}
            class="font-medium text-gray-800 transition-all duration-200 hover:text-red-950 hover:underline"
          >
            {currentLocale === "es" ? "Carta" : "Menu"}
          </a>
        </li>
        <li>
          <a
            href={contactURL}
            class="font-medium text-gray-800 transition-all duration-200 hover:text-red-950 hover:underline"
          >
            {currentLocale === "es" ? "Contactanos" : "Contact Us"}
          </a>
        </li>
        <li>
          <a
            href={galleryURL}
            class="font-medium text-gray-800 transition-all duration-200 hover:text-red-950 hover:underline"
          >
            {currentLocale === "es" ? "Galeria" : "Gallery"}
          </a>
        </li>
        <li>
          <a
            href={fullLocationURL}
            class="font-medium text-gray-800 transition-all duration-200 hover:text-red-950 hover:underline"
          >
            {currentLocale === "es" ? "Ubicacion" : "Location"}
          </a>
        </li>
      </ul>
    </nav>
  </article>
</header>

<style>
  .dents {
    position: relative;
  }

  .dents::after {
    content: "";
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 100%;
    height: 16px;
    background: linear-gradient(
      135deg,
      transparent 0%,
      transparent 25%,
      white 25%,
      white 75%,
      transparent 75%,
      transparent 100%
    );
    background-size: 16px 16px;
    background-repeat: repeat-x;
  }
</style>
